// Resources: application manifest, both icon sets and version info.
// Explorer shows the lowest-numbered icon group (the dark one) for the .exe file itself;
// the app switches the tray icon between the two at runtime.
#include <winver.h>
#include "resource.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif
#ifndef CREATEPROCESS_MANIFEST_RESOURCE_ID
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "WallpaperSwitcher.manifest"

IDI_APPICON_DARK  ICON "icons/WallpaperSwitcher-dark.ico"
IDI_APPICON_LIGHT ICON "icons/WallpaperSwitcher-light.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Wallpaper Switcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "WallpaperSwitcher"
            VALUE "OriginalFilename", "WallpaperSwitcher.exe"
            VALUE "ProductName", "Wallpaper Switcher"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
